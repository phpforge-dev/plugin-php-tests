{
  "id": "phpforge.php-tests",
  "name": "PHPUnit / Pest",
  "version": "1.0.0",
  "minIdeVersion": "0.2.11",
  "description": "PHPUnit / Pest: separate Rust tool service and workbench integration.",
  "main": "main.js",
  "activation": {
    "languages": [
      "php",
      "json"
    ],
    "files": []
  },
  "permissions": [
    "project.read",
    "native.tool",
    "workbench"
  ],
  "tool": {
    "protocolVersion": 1,
    "methods": [
      "testRun",
      "testCancel"
    ],
    "event": "test-progress",
    "workbench": "workbench.js",
    "style": "workbench.css",
    "binaries": {
      "aarch64-macos": {
        "path": "bin/aarch64-macos/phpforge-php-tests",
        "sha256": "c337111b06194cc423e8fa352d82b456c1b074f6d87b63ac8d9c2484730eb7f5"
      }
    }
  }
}
