{
  "id": "phpforge.php-tests",
  "name": "PHPUnit / Pest",
  "version": "1.2.0",
  "minIdeVersion": "0.2.20",
  "description": "PHPUnit / Pest: separate Rust tool service and workbench integration.",
  "main": "main.js",
  "activation": {
    "languages": [
      "php",
      "json"
    ],
    "files": []
  },
  "permissions": [
    "project.read",
    "native.tool",
    "workbench"
  ],
  "tool": {
    "protocolVersion": 1,
    "methods": [
      "testRun",
      "testCancel",
      "testEnvironment",
      "testConfigRead",
      "testConfigWrite"
    ],
    "event": "test-progress",
    "workbench": "workbench.js",
    "style": "workbench.css",
    "binaries": {
      "aarch64-macos": {
        "path": "bin/aarch64-macos/phpforge-php-tests",
        "sha256": "b06a05e96f0f0e9daad641dcdcf14c06f9cdf6bba353d65b9395edc1b3f3e412"
      },
      "x86_64-linux": {
        "path": "bin/x86_64-linux/phpforge-php-tests",
        "sha256": "37dbedea5cfcc8a1a7dd3a5e9996eed2c2ea465a0bccf3a1f29ade6a1ef2dfa4"
      },
      "x86_64-windows": {
        "path": "bin/x86_64-windows/phpforge-php-tests.exe",
        "sha256": "8941d084895b0fb1fd80506a1a70deb54b93de8581557d612dc5985fd662f21a"
      }
    }
  }
}
